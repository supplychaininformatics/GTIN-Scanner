# Template for .streamlit/secrets.toml (git-ignored — never commit the real file).
#
# Copy this to .streamlit/secrets.toml and fill in the two sections below: the
# Neon connection string the app stores scans in, and the admin allowlist that
# enables the refresh page (pages/admin.py). See README.md → "Admin refresh
# page" for how admin access works and its tradeoffs.
#
# Without this file, pages/admin.py still loads — nobody just matches an
# empty allowlist, so every typed email is denied (and logged as such). The
# scanner itself does not degrade so gracefully: with no [neon] url and no
# NEON_DATABASE_URL in the environment, core/store.py raises on first use.


[neon]
# Connection string for the Neon Postgres database holding sessions and scans
# (core/store.py). Copy it from the Neon console → Connection string.
#
# Put it HERE rather than in .env: .env is tracked in git, so a password added
# there would be committed. This file is git-ignored.
#
# Use the POOLED endpoint for the app — the host with `-pooler` in it. Every
# Streamlit interaction reruns the script, so unpooled connections accumulate
# quickly against a free-tier limit. The unpooled host is the right one for
# migrations and the retention sweep, which open a single short connection.
#
# The environment variable NEON_DATABASE_URL, if set, wins over this value —
# that is how .github/workflows/purge-expired.yml and any CLI script supply it.
url = "postgresql://USER:PASSWORD@ep-something-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

[admin]
# Emails allowed to see and use the refresh button, lower/upper case doesn't
# matter. Add one entry per manager/supervisor.
allowed_emails = ["manager1@example.org", "supervisor2@example.org"]

# Optional: grant everyone at a domain instead of listing each address. Either
# allowed_emails or allowed_domains matching is sufficient — comment out if
# unused.
# allowed_domains = ["example.org"]

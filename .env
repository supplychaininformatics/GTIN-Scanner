# ─────────────────────────────────────────────────────────────────────────────
# GTIN Barcode Scanner — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# "mock" | "fabric". Keep this on "mock" until the three FABRIC_* values below
# are filled in, otherwise startup will fail on the missing endpoint.
DATA_SOURCE=mock
LOG_LEVEL=INFO

# ── Microsoft Fabric Lakehouse (Production) ───────────────────────────────────
# Auth is Azure AD — there is NO password to set, and none is ever stored.
#
# Find the first two values in the Fabric workspace:
#   Lakehouse → "SQL analytics endpoint" → Settings → Connection string
FABRIC_SQL_ENDPOINT=cnekeaqnmtgunnmdsspqie3swa-fzzj7pxkurlexnuxubnwz34u6u.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=Silver_Lake

# The table/view holding contract lines.
FABRIC_TABLE=[Silver_Lake].[infor].[contract_line]

# ActiveDirectoryInteractive (default) — browser sign-in popup on this machine.
# ActiveDirectoryDeviceCode — prints a code instead; use if no browser can open.
# ActiveDirectoryDefault — reuses an existing `az login` / VS Code session.
FABRIC_AUTH=ActiveDirectoryDefault

# Override only if your installed driver has a different name
# (e.g. "ODBC Driver 17 for SQL Server").
# FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ── goodID / AccessGUDID API ─────────────────────────────────────────────────
# The FDA AccessGUDID API is public — no credentials required.
# Docs: https://accessgudid.nlm.nih.gov/api_docs
# No env vars needed for this integration.

# ─────────────────────────────────────────────────────────────────────────────
# GTIN Barcode Scanner — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# "mock" | "fabric". Default: "mock"
DATA_SOURCE=mock
LOG_LEVEL=INFO

# ── Microsoft Fabric Lakehouse (Production) ───────────────────────────────────
# Auth is Azure AD — there is NO password to set, and none is ever stored.
# Endpoint + database: Fabric workspace → Lakehouse → "SQL analytics endpoint"
#   → Settings → Connection string.
# FABRIC_SQL_ENDPOINT=xxxxx.datawarehouse.fabric.microsoft.com
# FABRIC_DATABASE=your_lakehouse_name
# FABRIC_TABLE=gold.fsm_contractline
# FABRIC_AUTH=ActiveDirectoryInteractive
# FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ── goodID / AccessGUDID API ─────────────────────────────────────────────────
# The FDA AccessGUDID API is public — no credentials required.
# Docs: https://accessgudid.nlm.nih.gov/api_docs
# No env vars needed for this integration.

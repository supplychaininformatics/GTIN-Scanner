# ─────────────────────────────────────────────────────────────────────────────
# GTIN Barcode Scanner — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# "mock" | "fabric". Default: "mock"
DATA_SOURCE=mock
LOG_LEVEL=INFO

# Optional override for the DATA_SOURCE=mock dataset (.parquet or .xlsx).
# Leave blank to use the committed data/mock/contract_line.parquet, which is
# what a deployed container will find; without it the app silently serves the
# 20-row built-in sample. ~/Downloads/contract_line.xlsx is still picked up
# automatically as a last resort for existing local setups.
# MOCK_DATA_PATH=

# The handheld app's URL once deployed. Shown on the monitor board for
# one-time device onboarding: open this URL directly on the handheld →
# Add to Home Screen. Leave blank until a real deploy URL exists — the
# board falls back to a placeholder notice.
# DEPLOY_URL=https://your-deployment.example.org

# ── Microsoft Fabric Lakehouse (Production) ───────────────────────────────────
# Auth is Azure AD — there is NO password to set, and none is ever stored.
# Endpoint + database: Fabric workspace → Lakehouse → "SQL analytics endpoint"
#   → Settings → Connection string.
# FABRIC_SQL_ENDPOINT=xxxxx.datawarehouse.fabric.microsoft.com
# FABRIC_DATABASE=your_lakehouse_name
# FABRIC_TABLE=gold.fsm_contractline
# FABRIC_AUTH=ActiveDirectoryInteractive
# FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ── goodID / AccessGUDID API ─────────────────────────────────────────────────
# The FDA AccessGUDID API is public — no credentials required.
# Docs: https://accessgudid.nlm.nih.gov/api_docs
# No env vars needed for this integration.

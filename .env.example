# ─────────────────────────────────────────────────────────────────────────────
# GTIN Barcode Scanner — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Set to "redshift" when VPN is available. Default: "mock"
DATA_SOURCE=mock
LOG_LEVEL=INFO

# ── AWS Redshift (Production) ─────────────────────────────────────────────────
# Uncomment and fill in when VPN access is available.
# REDSHIFT_HOST=your-cluster.region.redshift.amazonaws.com
# REDSHIFT_PORT=5439
# REDSHIFT_DB=your_database
# REDSHIFT_USER=your_user
# REDSHIFT_PASSWORD=your_password

# ── goodID / AccessGUDID API ─────────────────────────────────────────────────
# The FDA AccessGUDID API is public — no credentials required.
# Docs: https://accessgudid.nlm.nih.gov/api_docs
# No env vars needed for this integration.
